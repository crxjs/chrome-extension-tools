exports[`serve fs output > src/content.js.js 1`] = `
"// the dynamic import forces a loader file, so the imported chunk is only
// usable on pages covered by web_accessible_resources
;(async () => {
  const { logMessage } = await import(\\"/src/message.js.js\\")
  logMessage()
})().catch(console.error)
"
`;

exports[`serve fs output > src/content.js-loader.js 1`] = `
"(function () {
  'use strict';

  if (\\"<hmr-token>\\") {
    const channel = \`@crx/main:\${\\"<hmr-token>\\"}\`;
    const key = Symbol.for(channel);
    const scope = globalThis;
    if (!scope[key]) {
      scope[key] = true;
      const port = chrome.runtime.connect({
        name: \`@crx/client:\${\\"<hmr-token>\\"}\`
      });
      let connected = false;
      port.onMessage.addListener((message) => {
        if (JSON.parse(message.data).type === \\"connected\\")
          connected = true;
        window.postMessage({ channel, data: message.data }, \\"*\\");
      });
      window.addEventListener(\\"message\\", (event) => {
        if (event.source === window && event.data?.channel === channel && event.data?.ready === true && connected) {
          window.postMessage(
            { channel, data: JSON.stringify({ type: \\"connected\\" }) },
            \\"*\\"
          );
        }
      });
    }
  }
  const script = document.createElement(\\"script\\");
  script.type = \\"module\\";
  script.src = \`\${chrome.runtime.getURL(\\"src/content.js-loader.js.main.js\\")}?execute=\${crypto.getRandomValues(new Uint32Array(2)).join(\\"-\\")}\`;
  script.addEventListener(\\"load\\", () => script.remove(), { once: true });
  script.addEventListener(
    \\"error\\",
    () => {
      console.error(\\"[crx] MAIN world module failed to load\\", script.src);
      script.remove();
    },
    { once: true }
  );
  (document.head || document.documentElement).append(script);

})();
"
`;

exports[`serve fs output > src/content.js-loader.js.main.js 1`] = `
"(function () {
  'use strict';

  const injectTime = performance.now();
  (async () => {
    try {
      if (\\"\\")
        await import(
          /* @vite-ignore */
          \\"\\"
        );
      await import(
        /* @vite-ignore */
        \\"../vendor/vite-client.js\\"
      );
    } catch (error) {
      console.warn(\\"[crx] MAIN world HMR client failed to load\\", error);
    }
    const { onExecute } = await import(
      /* @vite-ignore */
      \\"./content.js.js\\"
    );
    onExecute?.({
      perf: { injectTime, loadTime: performance.now() - injectTime }
    });
  })().catch(console.error);

})();
"
`;

exports[`serve fs output > src/content2.js.js 1`] = `
"// declared with <all_urls> plus a narrower match_about_blank entry; the
// web_accessible_resources matches should collapse to just <all_urls>
