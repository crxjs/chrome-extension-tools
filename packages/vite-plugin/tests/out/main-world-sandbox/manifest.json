{
  "manifest_version": 3,
  "name": "MAIN module and sandbox output",
  "version": "1.0.0",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://example.com/*"],
      "js": ["main.js"],
      "world": "MAIN"
    }
  ],
  "sandbox": {
    "pages": ["sandbox.html"]
  }
}
