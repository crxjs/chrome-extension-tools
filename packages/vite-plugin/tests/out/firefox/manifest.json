{
  "manifest_version": 3,
  "name": "Firefox output compatibility",
  "version": "1.0.0",
  "background": { "scripts": ["background.js"], "type": "module" },
  "content_scripts": [
    { "matches": ["https://example.com/*"], "js": ["main.js"], "world": "MAIN" }
  ],
  "sandbox": { "pages": ["sandbox.html"] },
  "browser_specific_settings": { "gecko": { "id": "output@crxjs.test" } }
}
